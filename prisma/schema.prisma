// Hirewise Connect — Prisma schema (Phase 0 scope)
// Covers MASTER_PROMPT.md Sections 4.1 (identity), 4.2 (clients), 4.3 (agents),
// plus Agreement, AgreementAcceptance, AuditLog, OutboxEvent, Job, Setting, Notification.
// Later phases add the remaining aggregates from Section 4 without changing these tables' meaning.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  /// Runtime connection. On Supabase this is the Supavisor pooler (transaction mode) with ?pgbouncer=true.
  url        = env("DATABASE_URL")
  /// Migrations and introspection. On Supabase this is the direct (session) connection. Locally both point at the same server.
  directUrl  = env("DIRECT_URL")
  extensions = [citext]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleKey {
  SUPER_ADMIN
  ADMIN
  SALES
  RECRUITER
  COACH
  OPERATIONS
  AGENT
  CLIENT
  /// Signed up through "Apply for Agency"; no permissions until an application is approved (Agency A1).
  APPLICANT
  /// Granted only by agency application approval or Super Admin (Agency A1). Portal access comes from AgencyUser.
  AGENCY_OWNER
  AGENCY_MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ClientStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum RequirementStatus {
  OPEN
  IN_PROGRESS
  FILLED
  CLOSED
}

enum AgentProfileStatus {
  /// Identity phase 1: membership ended; the profile is read-only until archived.
  FORMER_AGENCY_AGENT
  /// Identity phase 1: archived; history only. A new profile may be active for the same identity.
  ARCHIVED
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REVISION_REQUIRED
  REJECTED
  HIDDEN
  SUSPENDED
}

enum AvailabilityStatus {
  AVAILABLE
  AVAILABLE_SOON
  INTERVIEWING
  RESERVED
  PLACED
  UNAVAILABLE
  PAUSED
}

enum VerificationLevel {
  PROFILE_SUBMITTED
  PROFILE_VERIFIED
  SKILLS_ASSESSED
  HIREWISE_CERTIFIED
  INTERVIEW_READY
  DEPLOYMENT_READY
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum WorkSetup {
  REMOTE
  OFFICE
  HYBRID
}

enum SkillLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum MediaStatus {
  DRAFT
  UPLOADED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUIRED
  RETIRED
}

enum VideoKind {
  INTRODUCTION
}

enum RecordingKind {
  INTRODUCTION
  COLD_CALL
  CUSTOMER_SERVICE
  SALES
  CUSTOM_CAMPAIGN
}

enum ReservationStatus {
  ACTIVE
  EXTENDED
  RELEASED
  EXPIRED
  CONVERTED
}

enum DocumentOwnerType {
  AGENT
  CLIENT
  PLACEMENT
  AGREEMENT
  AGENCY_APPLICATION
  AGENCY
  BYPASS_REPORT
}

enum DocumentVisibility {
  INTERNAL
  OWNER
  CLIENT
  AGENT
}

enum AgreementType {
  /// The one unified "Hirewise Connect Terms & Platform Agreement" (Identity phase 1).
  PLATFORM_TERMS
  /// Privacy Policy, accepted with the same checkbox (combined) or acknowledged separately.
  PRIVACY_POLICY
  /// Accepted when applying to run an agency (Agency A1).
  AGENCY_NON_CIRCUMVENTION
  /// Accepted on every candidate submission (Agency A5).
  SUBMISSION_TERMS
  CLIENT_TOS
  CLIENT_PRIVACY
  CLIENT_HIRING_TERMS
  CLIENT_NON_CIRCUMVENTION
  CLIENT_COMMUNICATION
  AGENT_PLATFORM_TERMS
  AGENT_PRIVACY
  AGENT_REPRESENTATION
  AGENT_NON_CIRCUMVENTION
  AGENT_CLIENT_COMMUNICATION
  AGENT_CONFIDENTIALITY
  PLACEMENT_SERVICE_AGREEMENT
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AuthTokenKind {
  MAGIC_LINK
  EMAIL_VERIFY
  PASSWORD_RESET
  /// Lets a sign-up that a duplicate flag blocked continue after Admin approval (Identity phase 1).
  SIGNUP_CONTINUATION
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum IntroductionEvent {
  VIEW
  SHORTLIST
  INTERVIEW
}

enum NoteSubjectType {
  AGENT
  CLIENT
  PLACEMENT
  INTERVIEW_REQUEST
}

enum NoteVisibility {
  INTERNAL
  AGENT
  CLIENT
}

// ---------------------------------------------------------------------------
// 4.5 Marketplace (Phase 1B)
// ---------------------------------------------------------------------------

model Shortlist {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String   @default("My Shortlist")
  createdById String
  isDefault   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidates ShortlistCandidate[]

  @@index([clientId])
}

/// Active membership is enforced by a partial unique index (shortlistId, agentProfileId) WHERE removedAt IS NULL.
model ShortlistCandidate {
  id             String       @id @default(cuid())
  shortlistId    String
  shortlist      Shortlist    @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  addedById      String
  addedAt        DateTime     @default(now())
  note           String?
  removedAt      DateTime?

  @@index([shortlistId, removedAt])
  @@index([agentProfileId])
}

model CandidateView {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  viewedAt       DateTime     @default(now())

  @@index([clientId, viewedAt])
  @@index([agentProfileId])
}

/// First recorded exposure of an agent to a client. Evidence for non-circumvention (Section 8.8).
model Introduction {
  id             String            @id @default(cuid())
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentProfileId String
  agentProfile   AgentProfile      @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  firstEvent     IntroductionEvent
  firstAt        DateTime          @default(now())

  @@unique([clientId, agentProfileId])
}

/// Internal notes. Never returned to Agent or Client roles unless visibility says so (INV-P4).
model AdminNote {
  id           String          @id @default(cuid())
  subjectType  NoteSubjectType
  subjectId    String
  authorUserId String
  body         String
  visibility   NoteVisibility  @default(INTERNAL)
  pinned       Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([subjectType, subjectId, createdAt])
}

// ---------------------------------------------------------------------------
// Authentication (Phase 1). Database sessions; tokens stored hashed.
// ---------------------------------------------------------------------------

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the cookie value. The raw token never touches the database.
  tokenHash  String   @unique
  /// True once TOTP has been verified for this session (or MFA is not required for the role).
  mfaPassed  Boolean  @default(false)
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id        String        @id @default(cuid())
  kind      AuthTokenKind
  /// SHA-256 of the emailed token.
  tokenHash String        @unique
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String        @db.Citext
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([email, kind])
}

model Task {
  id             String     @id @default(cuid())
  assigneeUserId String?
  assignee       User?      @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  /// When no assignee, the task belongs to a role queue (for example SALES).
  queueRole      RoleKey?
  type           String
  title          String
  dueAt          DateTime?
  status         TaskStatus @default(OPEN)
  relatedType    String?
  relatedId      String?
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([assigneeUserId, status])
  @@index([queueRole, status])
  @@index([relatedType, relatedId])
}

// ---------------------------------------------------------------------------
// 4.1 Identity and access
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(cuid())
  email           String     @unique @db.Citext
  passwordHash    String?
  status          UserStatus @default(ACTIVE)
  roleId          String
  role            Role       @relation(fields: [roleId], references: [id])
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean    @default(false)
  /// TOTP secret, AES-256-GCM encrypted with AUTH_SECRET. Never returned by any view.
  mfaSecretEnc    String?
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions                  Session[]
  authTokens                AuthToken[]
  tasksAssigned             Task[]              @relation("TaskAssignee")
  interviewRequestsAssigned InterviewRequest[]  @relation("RequestSales")
  placementsManaged         Placement[]         @relation("PlacementManager")
  coursesOwned              AcademyCourse[]     @relation("CourseOwner")
  courseCoachings           CourseCoach[]       @relation("CourseCoach")
  assessmentsGiven          Assessment[]        @relation("AssessmentCoach")
  evaluationsGiven          CoachEvaluation[]   @relation("EvaluationCoach")
  ratesProposed             ClientBillingRate[] @relation("RateProposer")
  ratesApproved             ClientBillingRate[] @relation("RateApprover")
  compensationsSet          AgentCompensation[] @relation("CompensationSetter")
  rateChanges               RateHistory[]       @relation("RateChanger")
  paymentsRecorded          Payment[]           @relation("PaymentRecorder")
  incidentsAsSubject        Incident[]          @relation("IncidentSubject")
  incidentsReported         Incident[]          @relation("IncidentReporter")
  incidentsResolved         Incident[]          @relation("IncidentResolver")

  permissionOverrides       UserPermissionOverride[]   @relation("OverrideSubject")
  onboardingVideoProgress   OnboardingVideoProgress[]
  grantedOverrides          UserPermissionOverride[]   @relation("OverrideGrantor")
  clientContact             ClientContact?
  agentProfiles             AgentProfile[]
  platformIdentity          PlatformIdentity?
  duplicateFlagsReviewed    DuplicateFlag[]            @relation("DuplicateFlagReviewer")
  agreementAcceptances      AgreementAcceptance[]
  notifications             Notification[]
  notificationPrefs         NotificationPreference[]
  managedClients            Client[]                   @relation("AccountManager")
  assignedRequirements      ClientRequirement[]        @relation("RequirementSales")
  reservationsMade          Reservation[]              @relation("ReservedBy")
  availabilityChanges       AgentAvailability[]        @relation("AvailabilitySetBy")
  documentsUploaded         Document[]                 @relation("DocumentUploader")
  profilesApproved          AgentProfile[]             @relation("ProfileApprover")
  videosReviewed            Video[]                    @relation("VideoReviewer")
  recordingsReviewed        Recording[]                @relation("RecordingReviewer")
  portfoliosReviewed        Portfolio[]                @relation("PortfolioReviewer")
  settingsUpdated           Setting[]                  @relation("SettingUpdater")
  // Agency marketplace (A1)
  agencyApplications        AgencyApplication[]        @relation("Applicant")
  reviewedApplications      AgencyApplication[]        @relation("ApplicationReviewer")
  applicationHistory        AgencyApplicationHistory[] @relation("ApplicationHistoryActor")
  ownedAgencies             Agency[]                   @relation("AgencyOwner")
  agencyUsers               AgencyUser[]
  membershipApprovals       AgencyMembership[]         @relation("MembershipApprover")
  clientSafeDocumentReviews ClientSafeDocument[]       @relation("ClientSafeDocumentReviewer")
  disclosureGrantsGiven     DisclosureGrant[]          @relation("DisclosureGrantedBy")
  messagesAuthored          Message[]                  @relation("MessageAuthor")
  threadsAssigned           MessageThread[]            @relation("ThreadStaff")
  bypassReportsFiled        BypassReport[]             @relation("BypassReporter")
  bypassReportsAgainst      BypassReport[]             @relation("BypassReported")
  bypassReportsAssigned     BypassReport[]             @relation("BypassAssignee")
  opportunitiesPublished    Opportunity[]              @relation("OpportunityPublisher")
  submissionsMade           Submission[]               @relation("SubmissionSubmitter")
  skillTagRequests          SkillTagRequest[]          @relation("SkillTagRequester")

  // Referral program: the personal code, who referred this user (write-once, enforced by a trigger), and the relations.
  referralCode            String?                @unique
  referredByUserId        String?
  referredAt              DateTime?
  referredBy              User?                  @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referrals               User[]                 @relation("UserReferrals")
  referralClicks          ReferralClick[]
  commissionsEarned       Commission[]           @relation("CommissionReferrer")
  commissionsBought       Commission[]           @relation("CommissionBuyer")
  commissionAdjustments   CommissionAdjustment[]
  payouts                 Payout[]
  payoutDetails           PayoutDetails?
  referralFlagsAsReferrer ReferralFlag[]         @relation("FlagReferrer")
  referralFlagsAsReferred ReferralFlag[]         @relation("FlagReferred")

  @@index([roleId])
  @@index([status])
  @@index([referredByUserId])
}

model Role {
  id          String           @id @default(cuid())
  key         RoleKey          @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String                   @id @default(cuid())
  key         String                   @unique
  group       String
  description String
  createdAt   DateTime                 @default(now())
  roles       RolePermission[]
  overrides   UserPermissionOverride[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermissionOverride {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation("OverrideSubject", fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedById  String
  grantedBy    User       @relation("OverrideGrantor", fields: [grantedById], references: [id])
  reason       String
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
}

// ---------------------------------------------------------------------------
// 4.2 Clients
// ---------------------------------------------------------------------------

model Client {
  id                   String       @id @default(cuid())
  companyName          String
  industry             String?
  website              String?
  country              String?
  timezone             String?
  status               ClientStatus @default(PENDING_REVIEW)
  accountManagerUserId String?
  accountManager       User?        @relation("AccountManager", fields: [accountManagerUserId], references: [id])
  source               String?
  deletedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  contacts          ClientContact[]
  onboarding        ClientOnboarding?
  requirements      ClientRequirement[]
  reservations      Reservation[]
  shortlists        Shortlist[]
  candidateViews    CandidateView[]
  introductions     Introduction[]
  interviewRequests InterviewRequest[]
  placements        Placement[]
  invoices          Invoice[]
  savedSearches     SavedSearch[]
  disclosureGrants  DisclosureGrant[]
  threads           MessageThread[]
  bypassReports     BypassReport[]
  opportunities     Opportunity[]

  @@index([status])
  @@index([accountManagerUserId])
}

model ClientContact {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id])
  name          String
  position      String?
  businessEmail String
  /// Restricted: never included in agent-facing projections (INV-P2).
  phone         String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
}

model ClientOnboarding {
  id                String    @id @default(cuid())
  clientId          String    @unique
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  servicesNeeded    String[]
  agentsRequired    Int?
  preferredSchedule String?
  expectedStartDate DateTime?
  notes             String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ClientRequirement {
  id                  String             @id @default(cuid())
  clientId            String
  client              Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title               String
  role                String
  jobDescription      String?
  skills              String[]
  industry            String?
  experienceLevel     ExperienceLevel?
  agentsRequired      Int                @default(1)
  schedule            String?
  timezone            String?
  software            String[]
  startDate           DateTime?
  /// Money in minor units; never floats (INV-I4).
  budgetMin           Int?
  budgetMax           Int?
  currency            String?            @db.Char(3)
  otherRequirements   String?
  status              RequirementStatus  @default(OPEN)
  assignedSalesUserId String?
  assignedSales       User?              @relation("RequirementSales", fields: [assignedSalesUserId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  interviewRequests   InterviewRequest[]
  opportunity         Opportunity?

  @@index([clientId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// 4.3 Agents
// ---------------------------------------------------------------------------

/// The spec's TalentProfile (Identity phase 1): one non-archived profile per user and per PlatformIdentity
/// (partial unique indexes in the migration). Archived profiles keep history for Hirewise only.
model AgentProfile {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id])
  platformIdentityId   String?
  platformIdentity     PlatformIdentity?  @relation(fields: [platformIdentityId], references: [id])
  talentType           TalentType         @default(HIREWISE_DIRECT)
  archivedAt           DateTime?
  /// v2 phase 3: set when the agency membership ended (status FORMER_AGENCY_AGENT), cleared on rejoin or reactivation.
  formerAgencyId       String?
  formerAt             DateTime?
  displayName          String
  headline             String?
  primaryRole          String?
  summary              String?
  photoKey             String?
  yearsExperience      Int?
  experienceLevel      ExperienceLevel?
  /// City and country only. Exact address lives in AgentPrivateContact (INV-P1).
  locationCity         String?
  locationCountry      String?
  timezone             String?
  languages            String[]
  workSetup            WorkSetup?
  preferredShift       String?
  equipmentSummary     String?
  internetSummary      String?
  status               AgentProfileStatus @default(DRAFT)
  verificationLevel    VerificationLevel  @default(PROFILE_SUBMITTED)
  /// True when an admin set the level by hand; cleared when a recompute confirms it (Section 5.6).
  verificationIsManual Boolean            @default(false)
  availabilityStatus   AvailabilityStatus @default(UNAVAILABLE)
  availableFrom        DateTime?
  profileCompletion    Int                @default(0)
  submittedAt          DateTime?
  approvedAt           DateTime?
  approvedById         String?
  approvedBy           User?              @relation("ProfileApprover", fields: [approvedById], references: [id])
  hiddenAt             DateTime?
  suspendedAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  privateContact        AgentPrivateContact?
  skills                AgentSkill[]
  experiences           Experience[]
  industryExperiences   IndustryExperience[]
  softwareExperiences   SoftwareExperience[]
  availabilityHistory   AgentAvailability[]
  reservations          Reservation[]
  videos                Video[]
  recordings            Recording[]
  portfolioItems        Portfolio[]
  shortlistEntries      ShortlistCandidate[]
  candidateViews        CandidateView[]
  introductions         Introduction[]
  interviewCandidacies  InterviewRequestCandidate[]
  interviews            Interview[]
  placements            Placement[]
  billingRates          ClientBillingRate[]
  compensations         AgentCompensation[]
  enrollments           CourseEnrollment[]
  assessments           Assessment[]
  coachEvaluations      CoachEvaluation[]
  certifications        Certification[]
  lessonProgress        LessonProgress[]
  quizAttempts          QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  courseProgress        CourseProgress[]
  /// Current primary agency (null = Hirewise Direct). History lives in AgencyMembership (Agency A1).
  primaryAgencyId       String?
  primaryAgency         Agency?                     @relation("PrimaryAgencyAgents", fields: [primaryAgencyId], references: [id])
  agencyMemberships     AgencyMembership[]
  /// v2 phase 5: what clients see instead of the display name (first name + last initial), kept from the legal name unless overridden.
  clientLabel           String?
  clientLabelOverride   Boolean                     @default(false)
  clientSafeDocuments   ClientSafeDocument[]
  disclosureGrants      DisclosureGrant[]
  threads               MessageThread[]
  submissions           Submission[]

  @@index([status])
  @@index([userId])
  @@index([platformIdentityId])
  @@index([primaryAgencyId])
  @@index([availabilityStatus])
  @@index([verificationLevel])
  @@index([primaryRole])
  @@index([timezone])
}

/// Read requires `agent.read_private_contact`. Never joined into client-facing views (INV-P1).
model AgentPrivateContact {
  id               String       @id @default(cuid())
  agentProfileId   String       @unique
  agentProfile     AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  fullLegalName    String
  personalEmail    String?
  phone            String?
  addressLine      String?
  resumeKey        String?
  /// Encrypted-at-rest references only; never raw ID numbers.
  governmentIdRefs Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Skill {
  id                      String                   @id @default(cuid())
  name                    String                   @unique
  category                String
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  agents                  AgentSkill[]
  /// Skills system: the tag as shown (#ColdCalling) and how it becomes verified. Verification is derived, never set by hand.
  slug                    String?                  @unique
  hashtag                 String?
  description             String?
  verificationMode        SkillVerificationMode    @default(NONE)
  requiredCourseId        String?
  requiredCourse          AcademyCourse?           @relation("SkillRequiredCourse", fields: [requiredCourseId], references: [id])
  requiredPathwayId       String?
  requiredPathway         SkillPathway?            @relation(fields: [requiredPathwayId], references: [id])
  minAssessmentScore      Int                      @default(80)
  courses                 CourseSkillTag[]
  certificationTemplates  CertificationTemplate[]
  opportunityRequirements OpportunityRequirement[]
  requestsMerged          SkillTagRequest[]        @relation("SkillTagRequestMerged")
  requestsCreated         SkillTagRequest[]        @relation("SkillTagRequestCreated")
}

model AgentSkill {
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill        @relation(fields: [skillId], references: [id])
  /// Derived by skill-verification.service only; a user action never writes it.
  verifiedAt     DateTime?
  verifiedVia    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([agentProfileId, skillId])
  @@index([skillId])
  @@index([skillId, verifiedAt])
}

model Experience {
  id             String       @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  company        String?
  title          String
  industry       String?
  startDate      DateTime
  endDate        DateTime?
  description    String?
  isCampaign     Boolean      @default(false)
  campaignType   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([agentProfileId])
}

model IndustryExperience {
  id             String       @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  industry       String
  years          Int          @default(0)

  @@unique([agentProfileId, industry])
}

model Software {
  id        String               @id @default(cuid())
  name      String               @unique
  category  String
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  agents    SoftwareExperience[]
}

model SoftwareExperience {
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  softwareId     String
  software       Software     @relation(fields: [softwareId], references: [id])
  level          SkillLevel   @default(BASIC)

  @@id([agentProfileId, softwareId])
}

/// Availability history. Current value is denormalized on AgentProfile.availabilityStatus.
model AgentAvailability {
  id             String             @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile       @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  status         AvailabilityStatus
  availableFrom  DateTime?
  reason         String?
  setById        String?
  setBy          User?              @relation("AvailabilitySetBy", fields: [setById], references: [id])
  setAt          DateTime           @default(now())

  @@index([agentProfileId, setAt])
}

/// Only one ACTIVE reservation per agent: enforced by a partial unique index in migration SQL.
model Reservation {
  id             String            @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile      @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  placementId    String?
  reservedById   String
  reservedBy     User              @relation("ReservedBy", fields: [reservedById], references: [id])
  reason         String?
  startsAt       DateTime          @default(now())
  expiresAt      DateTime
  status         ReservationStatus @default(ACTIVE)
  extensions     Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([agentProfileId, status])
  @@index([expiresAt, status])
}

model Video {
  id             String       @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  kind           VideoKind    @default(INTRODUCTION)
  storageKey     String
  durationSec    Int?
  status         MediaStatus  @default(DRAFT)
  isCurrent      Boolean      @default(false)
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?        @relation("VideoReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  /// Internal review feedback: visible to the agent and Hirewise staff, never to clients.
  reviewFeedback String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([agentProfileId, status])
}

model Recording {
  id             String        @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile  @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  kind           RecordingKind
  title          String
  storageKey     String
  durationSec    Int?
  status         MediaStatus   @default(DRAFT)
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?         @relation("RecordingReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewFeedback String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([agentProfileId, status])
}

model Portfolio {
  id             String       @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  storageKey     String?
  url            String?
  status         MediaStatus  @default(DRAFT)
  reviewedById   String?
  reviewedBy     User?        @relation("PortfolioReviewer", fields: [reviewedById], references: [id])
  reviewFeedback String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([agentProfileId, status])
}

model Document {
  id           String             @id @default(cuid())
  ownerType    DocumentOwnerType
  ownerId      String
  kind         String
  storageKey   String
  uploadedById String
  uploadedBy   User               @relation("DocumentUploader", fields: [uploadedById], references: [id])
  visibility   DocumentVisibility @default(INTERNAL)
  createdAt    DateTime           @default(now())

  @@index([ownerType, ownerId])
}

// ---------------------------------------------------------------------------
// Agreements (INV-I2)
// ---------------------------------------------------------------------------

model Agreement {
  id                   String                @id @default(cuid())
  type                 AgreementType
  version              Int
  title                String
  bodyMarkdown         String
  bodyChecksum         String
  effectiveFrom        DateTime
  isActive             Boolean               @default(true)
  requiredForRole      RoleKey?
  /// Identity phase 1: the unified terms are required for several roles at once.
  requiredForRoles     RoleKey[]             @default([])
  /// Ordered sections: { key, title, audiences[], bodyMarkdown }. bodyMarkdown is their concatenation.
  sections             Json?
  isMaterialChange     Boolean               @default(false)
  requiresReacceptance Boolean               @default(true)
  privacyPolicyMode    PrivacyPolicyMode?
  changeNote           String?
  publishedById        String?
  publishedAt          DateTime?
  supersedesId         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  acceptances          AgreementAcceptance[]

  @@unique([type, version])
  @@index([isActive, requiredForRole])
}

model AgreementAcceptance {
  id            String            @id @default(cuid())
  agreementId   String
  agreement     Agreement         @relation(fields: [agreementId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  acceptedAt    DateTime          @default(now())
  ipAddress     String?
  userAgent     String?
  bodyChecksum  String
  placementId   String?
  /// Why the acceptance was recorded (Agency A1). PLACEMENT acceptances also carry placementId.
  context       AcceptanceContext @default(GENERAL)
  applicationId String?
  submissionId  String?
  /// Identity phase 1: the role and agency at acceptance time.
  role          RoleKey?
  agencyId      String?

  @@unique([agreementId, userId, placementId])
  @@index([agreementId, acceptedAt])
  @@index([applicationId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Operations: audit, outbox, jobs, settings, notifications
// ---------------------------------------------------------------------------

/// Append-only (INV-I3). A database trigger rejects UPDATE and DELETE (see migration).
model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  actorRole     RoleKey?
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  reason        String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, createdAt])
}

model Job {
  id        String    @id @default(cuid())
  type      String
  payload   Json
  runAt     DateTime  @default(now())
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  lockedAt  DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAt])
}

/// Welcome-video progress for the onboarding checklist. One row per user per video version (videoKey changes when
/// Admin replaces the video). watchedSeconds counts actually played time, so seeking to the end does not complete it.
model OnboardingVideoProgress {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoKey        String
  watchedSeconds  Float     @default(0)
  lastPositionSec Float     @default(0)
  durationSec     Float?
  percent         Int       @default(0)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, videoKey])
  @@index([videoKey, completedAt])
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation("SettingUpdater", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

model Notification {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  title         String
  body          String
  data          Json?
  readAt        DateTime?
  channelStatus Json?
  createdAt     DateTime  @default(now())

  @@index([userId, readAt])
}

model NotificationPreference {
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   String
  inApp  Boolean @default(true)
  email  Boolean @default(true)
  sms    Boolean @default(false)

  @@id([userId, type])
}

// ---------------------------------------------------------------------------
// 4.6 Interviews and placements (Phase 2)
// ---------------------------------------------------------------------------

enum InterviewRequestStatus {
  REQUESTED
  SALES_REVIEW
  CLIENT_CONFIRMATION
  CANDIDATE_CONFIRMATION
  SCHEDULED
  COMPLETED
  CLIENT_DECISION_PENDING
  CLOSED
  CANCELLED
}

enum InterviewCandidateStatus {
  PENDING
  CONFIRMED
  DECLINED
  WITHDRAWN
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW_CLIENT
  NO_SHOW_AGENT
  CANCELLED
}

enum ClientDecision {
  NONE
  INTERESTED
  SECOND_INTERVIEW
  SELECTED
  NOT_SELECTED
}

enum MessageVisibility {
  ALL
  HIREWISE_ONLY
  CLIENT_AND_HIREWISE
  AGENT_AND_HIREWISE
  /// v2 phase 6a: Partner Team enquiries.
  AGENCY_AND_HIREWISE
}

enum PlacementStatus {
  PENDING
  INTERVIEWING
  SELECTED
  AWAITING_AGREEMENT
  AWAITING_DEPOSIT
  DEPLOYMENT_PREP
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum FlagRule {
  CONTACT_INFO_IN_MESSAGE
  RATE_DISCUSSION_IN_MESSAGE
  PROFILE_VIEW_BURST
  SHORTLIST_CHURN
  CONTACT_INFO_IN_PROFILE
  /// v2 phase 6a: a pasted meeting link outside the allowed hosts.
  MEETING_LINK_REFUSED
}

model InterviewRequest {
  id                  String                 @id @default(cuid())
  clientId            String
  client              Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requirementId       String?
  requirement         ClientRequirement?     @relation(fields: [requirementId], references: [id])
  requestedById       String
  preferredDate       DateTime?
  preferredTime       String?
  timezone            String
  notes               String?
  role                String
  schedule            String?
  targetStartDate     DateTime?
  status              InterviewRequestStatus @default(REQUESTED)
  assignedSalesUserId String?
  assignedSales       User?                  @relation("RequestSales", fields: [assignedSalesUserId], references: [id])
  /// Internal only. Never in client or agent projections.
  salesNotes          String?
  cancelledReason     String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  candidates       InterviewRequestCandidate[]
  interviews       Interview[]
  messages         InterviewMessage[]
  placements       Placement[]
  /// v2 phase 6a: windows the client offered, free text per window.
  requestedWindows Json?
  thread           MessageThread?
  submissions      Submission[]

  @@index([clientId, status])
  @@index([status, createdAt])
  @@index([assignedSalesUserId])
}

model InterviewRequestCandidate {
  id                 String                   @id @default(cuid())
  interviewRequestId String
  interviewRequest   InterviewRequest         @relation(fields: [interviewRequestId], references: [id], onDelete: Cascade)
  agentProfileId     String
  agentProfile       AgentProfile             @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  status             InterviewCandidateStatus @default(PENDING)
  respondedAt        DateTime?
  createdAt          DateTime                 @default(now())

  @@unique([interviewRequestId, agentProfileId])
  @@index([agentProfileId])
}

model Interview {
  id                 String           @id @default(cuid())
  interviewRequestId String
  interviewRequest   InterviewRequest @relation(fields: [interviewRequestId], references: [id], onDelete: Cascade)
  agentProfileId     String
  agentProfile       AgentProfile     @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  round              Int              @default(1)
  scheduledAt        DateTime
  timezone           String
  durationMin        Int              @default(30)
  meetingLink        String?
  meetingProvider    String?
  meetingExternalId  String?
  coordinatorUserId  String?
  status             InterviewStatus  @default(SCHEDULED)
  clientDecision     ClientDecision   @default(NONE)
  clientFeedback     String?
  /// Internal only.
  internalFeedback   String?
  decidedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  placements   Placement[]
  /// v2 phase 6a: participants (labels and roles only) and whether the link came from the provider or was pasted by staff.
  participants Json?
  linkSource   MeetingLinkSource?

  @@index([interviewRequestId])
  @@index([agentProfileId])
  @@index([scheduledAt, status])
}

/// The only client-agent channel during hiring; always mediated by Hirewise (Sections 8.5 and 8.8).
model InterviewMessage {
  id                 String            @id @default(cuid())
  interviewRequestId String
  interviewRequest   InterviewRequest  @relation(fields: [interviewRequestId], references: [id], onDelete: Cascade)
  authorUserId       String
  authorRole         RoleKey
  body               String
  visibleTo          MessageVisibility @default(ALL)
  heldForReview      Boolean           @default(false)
  releasedById       String?
  releasedAt         DateTime?
  blockedAt          DateTime?
  createdAt          DateTime          @default(now())

  @@index([interviewRequestId, createdAt])
}

model Placement {
  id                   String             @id @default(cuid())
  clientId             String
  client               Client             @relation(fields: [clientId], references: [id])
  agentProfileId       String
  agentProfile         AgentProfile       @relation(fields: [agentProfileId], references: [id])
  requirementId        String?
  interviewRequestId   String?
  interviewRequest     InterviewRequest?  @relation(fields: [interviewRequestId], references: [id])
  interviewId          String?
  interview            Interview?         @relation(fields: [interviewId], references: [id])
  positionTitle        String
  schedule             String?
  timezone             String?
  startDate            DateTime?
  status               PlacementStatus    @default(SELECTED)
  accountManagerUserId String?
  accountManager       User?              @relation("PlacementManager", fields: [accountManagerUserId], references: [id])
  approvedById         String?
  activatedAt          DateTime?
  endedAt              DateTime?
  endReason            String?
  cancelledReason      String?
  /// Snapshot refs taken at Hirewise approval (Section 4.6). Compensation ref is restricted (INV-C1).
  clientBillingRateId  String?
  clientBillingRate    ClientBillingRate? @relation(fields: [clientBillingRateId], references: [id])
  agentCompensationId  String?
  agentCompensation    AgentCompensation? @relation(fields: [agentCompensationId], references: [id])
  agreementAcceptedAt  DateTime?
  signedAgreementKey   String?
  pausedAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  deposit        Deposit?
  invoices       Invoice[]
  checklistItems DeploymentChecklistItem[]

  @@index([clientId, status])
  @@index([agentProfileId, status])
  @@index([status])
}

/// Rule-generated signals for admin review (Section 8.8). Only on-platform activity is inspected.
model ActivityFlag {
  id           String    @id @default(cuid())
  userId       String
  rule         FlagRule
  details      Json?
  relatedType  String?
  relatedId    String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([rule, reviewedAt])
}

// ---------------------------------------------------------------------------
// 4.4 Academy (Phase 3) — courses, exams, enrollments, assessments, certifications
// ---------------------------------------------------------------------------

enum CourseStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
  /// v2 phase 4: agency-sponsored access withdrawn at exit.
  REVOKED
}

enum EnrollmentSource {
  INTERNAL
  ACADEMY_SYNC
}

enum CoursePaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  WAIVED
  REFUNDED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum AssessmentType {
  EXAM
  PRACTICAL
  ROLEPLAY
  MOCK_CALL
  SKILL
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  FINAL
  /// v2 phase 4: agency-sponsored assessment no longer counts after exit.
  HISTORICAL
}

enum CertificationOrigin {
  ACADEMY
  ADMIN_ISSUED
}

enum CertificationStatus {
  PENDING_REVIEW
  APPROVED
  REVOKED
  EXPIRED
  /// v2 phase 4: agency-sponsored certification no longer counts for platform use after exit (not a revocation for cause).
  INACTIVE_FOR_PLATFORM_USE
}

model AcademyCourse {
  coursePurchases                   CoursePurchase[]
  id                                String                 @id @default(cuid())
  code                              String                 @unique
  title                             String
  /// Legacy free-text category; categoryId is the source of truth once the builder lands (phase 2 drops this column).
  category                          String
  categoryId                        String?
  categoryRef                       CourseCategory?        @relation(fields: [categoryId], references: [id])
  description                       String
  thumbnailKey                      String?
  difficulty                        CourseDifficulty       @default(BEGINNER)
  estimatedMinutes                  Int?
  /// Required courses count toward a talent's onboarding and show first in the catalog.
  isRequired                        Boolean                @default(false)
  /// Learners must finish modules in order; off unless the creator enables it.
  sequentialUnlock                  Boolean                @default(false)
  /// Completion rules: every required lesson is always needed; these add quiz passes and a final assessment pass.
  completionRequiresQuizPass        Boolean                @default(true)
  completionRequiresFinalAssessment Boolean                @default(false)
  displayOrder                      Int                    @default(0)
  introVideoUrl                     String?
  welcomeMessage                    String?
  /// Optional JSON gate: { minVerificationLevel?, roles? }. Null = any enrolled talent.
  accessRules                       Json?
  /// Markdown syllabus / lesson content shown to enrolled agents.
  syllabus                          String?
  /// Optional link to externally hosted lessons.
  contentUrl                        String?
  ownerCoachUserId                  String
  ownerCoach                        User                   @relation("CourseOwner", fields: [ownerCoachUserId], references: [id])
  /// Price in USD cents; 0 = free (INV-I4).
  priceCents                        Int                    @default(0)
  currency                          String                 @default("USD") @db.Char(3)
  passingScore                      Int                    @default(70)
  requiresCoachReview               Boolean                @default(false)
  certificationTemplateId           String?
  certificationTemplate             CertificationTemplate? @relation(fields: [certificationTemplateId], references: [id])
  status                            CourseStatus           @default(DRAFT)
  publishedAt                       DateTime?
  publishedById                     String?
  externalId                        String?                @unique
  createdAt                         DateTime               @default(now())
  updatedAt                         DateTime               @updatedAt

  coaches           CourseCoach[]
  enrollments       CourseEnrollment[]
  exam              Exam?
  assessments       Assessment[]
  modules           CourseModule[]
  prerequisites     CoursePrerequisite[] @relation("CoursePrerequisiteOf")
  prerequisiteFor   CoursePrerequisite[] @relation("CoursePrerequisiteRequires")
  progress          CourseProgress[]
  questions         Question[]
  skillTags         CourseSkillTag[]
  pathwayCourses    PathwayCourse[]
  requiredForSkills Skill[]              @relation("SkillRequiredCourse")

  @@index([status, category])
  @@index([ownerCoachUserId])
}

enum LessonContentType {
  VIDEO
  AUDIO
  LINK
  DOCUMENT
  TEXT
  QUIZ
  ASSIGNMENT
  /// Formal assessment lesson (skills, final, certification). Distinct from the coach-written Assessment record.
  ASSESSMENT
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Module and lesson visibility to learners. Courses keep CourseStatus with Admin approval of the first publish.
enum PublishState {
  DRAFT
  PUBLISHED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  SHORT_ANSWER
}

/// SUGGESTED is reserved for AI-generated drafts; nothing SUGGESTED is ever shown to learners.
enum QuestionState {
  DRAFT
  PUBLISHED
  SUGGESTED
}

enum ReviewMode {
  AUTO
  MANUAL
  BOTH
}

enum ScorePolicy {
  HIGHEST
  LATEST
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
  RETAKE_REQUIRED
  PENDING_REVIEW
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  PENDING_REVIEW
}

enum SubmissionType {
  TEXT
  URL
  DOCUMENT
  OTHER
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

/// Curriculum: ordered modules of ordered lessons. Editable at any status, including PUBLISHED,
/// by the owner coach, assigned coaches, and Admin (course.manage).
model CourseModule {
  id          String        @id @default(cuid())
  courseId    String
  course      AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  description String?
  isRequired  Boolean       @default(true)
  status      PublishState  @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lessons CourseLesson[]

  @@index([courseId, order])
}

/// One piece of learning content. Exactly one source is used per contentType:
/// TEXT → body (markdown); LINK → url; VIDEO → url (hosted) or storageKey (uploaded); AUDIO/DOCUMENT → storageKey.
/// storageKey is never exposed to agents; files are streamed through a signed URL after an enrollment check.
model CourseLesson {
  id                 String            @id @default(cuid())
  moduleId           String
  module             CourseModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order              Int
  title              String
  contentType        LessonContentType
  /// Markdown body for TEXT lessons; optional notes for other types.
  body               String?
  url                String?
  storageKey         String?
  fileName           String?
  contentMime        String?
  sizeBytes          Int?
  durationSec        Int?
  description        String?
  isRequired         Boolean           @default(true)
  status             PublishState      @default(PUBLISHED)
  /// Bumped on significant edits; attempts and LessonVersion rows reference it.
  version            Int               @default(1)
  /// Audio / video: share of the media that must actually be played (not sought) before the lesson counts.
  requiredPercent    Int?
  /// Reserved for transcription and AI-generated questions.
  transcript         String?
  // Quiz, assessment, and audiobook-quiz settings
  passingScore       Int?
  /// Null = unlimited attempts.
  maxAttempts        Int?
  timeLimitMin       Int?
  /// Draw this many questions at random from the lesson's published questions; null = all, in order.
  randomizeCount     Int?
  shuffleAnswers     Boolean           @default(false)
  showCorrectAnswers Boolean           @default(true)
  showExplanations   Boolean           @default(true)
  retakeWaitMinutes  Int?
  scorePolicy        ScorePolicy       @default(HIGHEST)
  reviewMode         ReviewMode        @default(AUTO)
  // Assignment settings
  dueAt              DateTime?
  points             Int?
  submissionType     SubmissionType?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  questions   Question[]
  attempts    QuizAttempt[]
  progress    LessonProgress[]
  submissions AssignmentSubmission[]
  versions    LessonVersion[]

  @@index([moduleId, order])
}

/// Admin-managed course categories (seeded, never hardcoded in the UI).
model CourseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses AcademyCourse[]
}

model CoursePrerequisite {
  courseId         String
  course           AcademyCourse @relation("CoursePrerequisiteOf", fields: [courseId], references: [id], onDelete: Cascade)
  requiresCourseId String
  requires         AcademyCourse @relation("CoursePrerequisiteRequires", fields: [requiresCourseId], references: [id], onDelete: Cascade)

  @@id([courseId, requiresCourseId])
}

/// One question system for quizzes, exams, assessments, and audiobook quizzes.
/// lessonId null = question-bank only; courseId / moduleId / topic / difficulty organise the bank.
model Question {
  id          String            @id @default(cuid())
  lessonId    String?
  lesson      CourseLesson?     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId    String?
  course      AcademyCourse?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  topic       String?
  difficulty  CourseDifficulty?
  type        QuestionType      @default(MULTIPLE_CHOICE)
  prompt      String
  explanation String?
  points      Int               @default(1)
  isRequired  Boolean           @default(true)
  order       Int               @default(0)
  state       QuestionState     @default(PUBLISHED)
  version     Int               @default(1)
  /// Short answer: accepted keywords for automatic matching; empty = manual review.
  keywords    String[]          @default([])
  /// "coach" or "ai"; AI output never publishes without coach approval.
  source      String            @default("coach")
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  choices QuestionChoice[]

  @@index([lessonId, order])
  @@index([courseId, topic])
}

/// Correctness is tracked by choice id, never by position, so shuffling cannot break scoring.
model QuestionChoice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@index([questionId, order])
}

/// Per-learner lesson state. Media fields count actually played seconds; seeking never advances them.
model LessonProgress {
  id               String               @id @default(cuid())
  lessonId         String
  lesson           CourseLesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  agentProfileId   String
  agentProfile     AgentProfile         @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  status           LessonProgressStatus @default(NOT_STARTED)
  startedAt        DateTime?
  completedAt      DateTime?
  mediaSeconds     Float                @default(0)
  lastPositionSec  Float                @default(0)
  mediaPercent     Int                  @default(0)
  mediaCompletedAt DateTime?
  lessonVersion    Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([lessonId, agentProfileId])
  @@index([agentProfileId, status])
}

/// Immutable attempt history. questionSnapshot freezes the question ids, versions, points, and the choice
/// order shown; answers map questionId → chosen choice ids or text. Later edits never rewrite a result.
model QuizAttempt {
  id               String            @id @default(cuid())
  lessonId         String
  lesson           CourseLesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  agentProfileId   String
  agentProfile     AgentProfile      @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  lessonVersion    Int               @default(1)
  status           QuizAttemptStatus @default(IN_PROGRESS)
  questionSnapshot Json
  answers          Json?
  scorePercent     Int?
  passed           Boolean?
  startedAt        DateTime          @default(now())
  submittedAt      DateTime?
  expiresAt        DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  feedback         String?

  @@index([lessonId, agentProfileId, startedAt])
}

model AssignmentSubmission {
  id             String           @id @default(cuid())
  lessonId       String
  lesson         CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  agentProfileId String
  agentProfile   AgentProfile     @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  submissionType SubmissionType
  text           String?
  url            String?
  storageKey     String?
  fileName       String?
  status         SubmissionStatus @default(SUBMITTED)
  grade          Int?
  feedback       String?
  reviewedById   String?
  reviewedAt     DateTime?
  submittedAt    DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([lessonId, agentProfileId])
}

/// Cached course progress for dashboards and the tracking table; recalculated on every lesson change.
model CourseProgress {
  id              String        @id @default(cuid())
  courseId        String
  course          AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  agentProfileId  String
  agentProfile    AgentProfile  @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  requiredTotal   Int           @default(0)
  requiredDone    Int           @default(0)
  percent         Int           @default(0)
  currentLessonId String?
  completedAt     DateTime?
  updatedAt       DateTime      @updatedAt

  @@unique([courseId, agentProfileId])
  @@index([agentProfileId])
}

/// Snapshot of a lesson (and its questions) before a significant edit.
model LessonVersion {
  id          String       @id @default(cuid())
  lessonId    String
  lesson      CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  changedById String?
  changedAt   DateTime     @default(now())
  reason      String?

  @@unique([lessonId, version])
}

model CourseCoach {
  courseId    String
  course      AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  coachUserId String
  coach       User          @relation("CourseCoach", fields: [coachUserId], references: [id], onDelete: Cascade)
  addedAt     DateTime      @default(now())

  @@id([courseId, coachUserId])
  @@index([coachUserId])
}

model CourseEnrollment {
  id                     String              @id @default(cuid())
  courseId               String
  course                 AcademyCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  agentProfileId         String
  agentProfile           AgentProfile        @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  status                 EnrollmentStatus    @default(ENROLLED)
  source                 EnrollmentSource    @default(INTERNAL)
  paymentStatus          CoursePaymentStatus @default(NOT_REQUIRED)
  /// Snapshot of the course price at enrollment, USD cents.
  priceCents             Int                 @default(0)
  paidCents              Int?
  paymentReference       String?
  paidAt                 DateTime?
  paymentRecordedById    String?
  /// v2 phase 4: who funded this access. Agency-sponsored access ends with the membership.
  credentialSource       CredentialSource    @default(HIREWISE_DIRECT)
  sponsoringAgencyId     String?
  courseSeatAssignmentId String?
  accessRevokedAt        DateTime?
  revokeReason           String?
  enrolledAt             DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  completion CourseCompletion?
  attempts   ExamAttempt[]

  /// Referral program: a recorded refund or chargeback (staff action). Access ends with it.
  refundedAt   DateTime?
  refundKind   RefundKind?
  refundReason String?

  @@unique([courseId, agentProfileId])
  @@index([agentProfileId, status])
}

model CourseCompletion {
  id           String           @id @default(cuid())
  enrollmentId String           @unique
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  completedAt  DateTime         @default(now())
  examScore    Int?
  source       EnrollmentSource @default(INTERNAL)
  externalRef  String?
}

/// One exam per course, built by the course coach. Questions are single-answer multiple choice.
model Exam {
  id           String        @id @default(cuid())
  courseId     String        @unique
  course       AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  instructions String?
  timeLimitMin Int?
  maxAttempts  Int           @default(2)
  status       ExamStatus    @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  questions ExamQuestion[]
  attempts  ExamAttempt[]
}

model ExamQuestion {
  id           String   @id @default(cuid())
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  order        Int
  prompt       String
  /// Answer choices in display order.
  options      String[]
  /// Index into options. Never included in agent-facing projections.
  correctIndex Int
  points       Int      @default(1)
  explanation  String?

  @@index([examId, order])
}

model ExamAttempt {
  id           String           @id @default(cuid())
  examId       String
  exam         Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// questionId -> chosen option index
  answers      Json?
  scorePercent Int?
  passed       Boolean?
  status       AttemptStatus    @default(IN_PROGRESS)
  startedAt    DateTime         @default(now())
  submittedAt  DateTime?
  expiresAt    DateTime?

  @@index([enrollmentId, status])
}

/// Configurable result labels (Section "Coach assessment").
model AssessmentResultLabel {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  rank      Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  assessments Assessment[]
  evaluations CoachEvaluation[]
}

model Assessment {
  id                       String                 @id @default(cuid())
  courseId                 String?
  course                   AcademyCourse?         @relation(fields: [courseId], references: [id])
  agentProfileId           String
  agentProfile             AgentProfile           @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  coachUserId              String
  coach                    User                   @relation("AssessmentCoach", fields: [coachUserId], references: [id])
  type                     AssessmentType
  examScore                Int?
  practicalScore           Int?
  roleplayScore            Int?
  communicationScore       Int?
  /// skillId -> score 0..100
  skillScores              Json?
  comments                 String?
  strengths                String?
  areasForImprovement      String?
  resultLabelId            String?
  resultLabel              AssessmentResultLabel? @relation(fields: [resultLabelId], references: [id])
  certificationRecommended Boolean                @default(false)
  credentialSource         CredentialSource       @default(HIREWISE_DIRECT)
  sponsoringAgencyId       String?
  historicalAt             DateTime?
  status                   AssessmentStatus       @default(DRAFT)
  assessedAt               DateTime               @default(now())
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  certifications Certification[]

  @@index([agentProfileId, status])
  @@index([courseId])
  @@index([coachUserId])
}

model CoachEvaluation {
  id               String                 @id @default(cuid())
  agentProfileId   String
  agentProfile     AgentProfile           @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  coachUserId      String
  coach            User                   @relation("EvaluationCoach", fields: [coachUserId], references: [id])
  summary          String
  communication    Int
  reliability      Int
  coachability     Int
  overallLabelId   String?
  overallLabel     AssessmentResultLabel? @relation(fields: [overallLabelId], references: [id])
  visibleToClients Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([agentProfileId])
}

model CertificationTemplate {
  id                  String   @id @default(cuid())
  name                String   @unique
  description         String?
  validityMonths      Int?
  badgeKey            String?
  /// Rule (Section 4.4 CertificationRequirement), evaluated on completion and assessment.
  requiresCompletion  Boolean  @default(true)
  minExamScore        Int?
  requiresCoachReview Boolean  @default(false)
  minResultLabelRank  Int?
  /// Which per-type scores clients may see (Section 6, footnote 3).
  clientVisibleScores String[] @default(["examScore", "roleplayScore", "communicationScore"])
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  courses                 AcademyCourse[]
  certifications          Certification[]
  /// Skills system: the tag this certification validates.
  skillId                 String?
  skill                   Skill?                   @relation(fields: [skillId], references: [id])
  opportunityRequirements OpportunityRequirement[]
}

/// Never agent-writable (INV-I1).
model Certification {
  id                 String                @id @default(cuid())
  agentProfileId     String
  agentProfile       AgentProfile          @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  templateId         String
  template           CertificationTemplate @relation(fields: [templateId], references: [id])
  origin             CertificationOrigin
  issuedById         String?
  issuedAt           DateTime              @default(now())
  expiresAt          DateTime?
  assessmentId       String?
  assessment         Assessment?           @relation(fields: [assessmentId], references: [id])
  courseId           String?
  status             CertificationStatus   @default(PENDING_REVIEW)
  approvedById       String?
  approvedAt         DateTime?
  revokedReason      String?
  credentialSource   CredentialSource      @default(HIREWISE_DIRECT)
  sponsoringAgencyId String?
  inactivatedAt      DateTime?
  inactiveReason     String?
  /// Printed on the certificate; HC-YYYY-NNNNNN.
  certificateNumber  String?               @unique
  /// Opaque code for public verification.
  verificationCode   String?               @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([agentProfileId, templateId, courseId])
  @@index([agentProfileId, status])
  @@index([status, expiresAt])
}

/// Configurable ladder (Section 5.6). Rules JSON keys: profileApproved, videoApproved,
/// minApprovedRecordings, minApprovedCertifications, minAssessmentLabelRank, publishedBillingRate.
model VerificationRequirement {
  level     VerificationLevel @id
  rules     Json
  updatedAt DateTime          @updatedAt
}

// ---------------------------------------------------------------------------
// 4.7 Commercial (Phase 4) — billing rates, compensation, deposits, invoices, payments
// INV-C1: ClientBillingRate and AgentCompensation are separate tables. Never join them
// outside a report that checks both compensation.read and billing_rate.read.
// ---------------------------------------------------------------------------

enum RateUnit {
  HOURLY
  MONTHLY
}

enum BillingRateStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  RETIRED
}

enum RateSubjectType {
  CLIENT_BILLING_RATE
  AGENT_COMPENSATION
}

enum DepositPolicyType {
  ONE_MONTH
  TWO_WEEKS
  FIXED
  PERCENTAGE
  CUSTOM
}

enum DepositStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  WAIVED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  PAYPAL
  OTHER
}

/// What the client pays Hirewise for this agent. Clients see PUBLISHED only (INV-C3).
model ClientBillingRate {
  id               String            @id @default(cuid())
  agentProfileId   String
  agentProfile     AgentProfile      @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  /// Minor units (cents). Never floats (INV-C4 history keeps every change).
  amount           Int
  currency         String            @db.Char(3)
  unit             RateUnit
  status           BillingRateStatus @default(PENDING_APPROVAL)
  proposedById     String
  proposedBy       User              @relation("RateProposer", fields: [proposedById], references: [id])
  approvedById     String?
  approvedBy       User?             @relation("RateApprover", fields: [approvedById], references: [id])
  effectiveFrom    DateTime          @default(now())
  effectiveTo      DateTime?
  /// Internal only: never in any client, agent, or Sales projection (Section 6, footnote 7).
  positioningNotes String?
  decisionReason   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  placements Placement[]

  @@index([agentProfileId, status])
  @@index([status])
}

/// What Hirewise pays the agent. Read requires compensation.read; the agent sees their own.
model AgentCompensation {
  id             String       @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  amount         Int
  currency       String       @db.Char(3)
  unit           RateUnit
  effectiveFrom  DateTime     @default(now())
  effectiveTo    DateTime?
  setById        String
  setBy          User         @relation("CompensationSetter", fields: [setById], references: [id])
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  placements Placement[]

  @@index([agentProfileId, effectiveTo])
}

/// INV-C4: one row per change on either rate table, written in the same transaction.
model RateHistory {
  id             String          @id @default(cuid())
  subjectType    RateSubjectType
  subjectId      String
  agentProfileId String
  previousAmount Int?
  newAmount      Int
  currency       String          @db.Char(3)
  unit           RateUnit
  previousStatus String?
  newStatus      String?
  changedById    String
  changedBy      User            @relation("RateChanger", fields: [changedById], references: [id])
  reason         String?
  changedAt      DateTime        @default(now())

  @@index([subjectType, subjectId])
  @@index([agentProfileId, changedAt])
}

model DepositPolicy {
  id        String            @id @default(cuid())
  name      String            @unique
  type      DepositPolicyType
  /// FIXED/CUSTOM: minor units. PERCENTAGE: basis points of one month. Others: unused.
  value     Int               @default(0)
  currency  String?           @db.Char(3)
  isDefault Boolean           @default(false)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  deposits Deposit[]
}

model Deposit {
  id             String        @id @default(cuid())
  placementId    String        @unique
  placement      Placement     @relation(fields: [placementId], references: [id], onDelete: Cascade)
  policyId       String
  policy         DepositPolicy @relation(fields: [policyId], references: [id])
  requiredAmount Int
  currency       String        @db.Char(3)
  dueDate        DateTime
  status         DepositStatus @default(PENDING)
  waivedById     String?
  waivedReason   String?
  waivedAt       DateTime?
  approvedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  invoices Invoice[]
}

model Invoice {
  id                 String        @id @default(cuid())
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id])
  placementId        String?
  placement          Placement?    @relation(fields: [placementId], references: [id])
  depositId          String?
  deposit            Deposit?      @relation(fields: [depositId], references: [id])
  number             String        @unique
  description        String
  amount             Int
  currency           String        @db.Char(3)
  status             InvoiceStatus @default(ISSUED)
  issuedAt           DateTime      @default(now())
  dueAt              DateTime
  paidAt             DateTime?
  voidReason         String?
  pdfKey             String?
  /// Hosted checkout session id from the payment provider, when one was created.
  providerCheckoutId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payments Payment[]

  @@index([clientId, status])
  @@index([placementId])
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Int
  currency        String        @db.Char(3)
  method          PaymentMethod
  reference       String?
  paidAt          DateTime      @default(now())
  recordedById    String
  recordedBy      User          @relation("PaymentRecorder", fields: [recordedById], references: [id])
  providerPayload Json?
  createdAt       DateTime      @default(now())

  @@index([invoiceId])
}

/// Section 4.6 DeploymentChecklist: seeded from a template at DEPLOYMENT_PREP.
model DeploymentChecklistItem {
  id          String    @id @default(cuid())
  placementId String
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  order       Int
  label       String
  isRequired  Boolean   @default(true)
  isDone      Boolean   @default(false)
  doneById    String?
  doneAt      DateTime?

  @@index([placementId, order])
}

// ---------------------------------------------------------------------------
// Phase 5 — incidents (Section 4.8), saved searches (Section 13 Phase 5)
// ---------------------------------------------------------------------------

enum IncidentType {
  RATE_DISCUSSION
  OFF_PLATFORM_CONTACT
  DIRECT_HIRE_ATTEMPT
  POLICY_VIOLATION
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

/// Section 8.8: created by Admin or Sales from flags, held messages, or reports. Evidence is Document rows.
model Incident {
  id                  String           @id @default(cuid())
  subjectUserId       String
  subjectUser         User             @relation("IncidentSubject", fields: [subjectUserId], references: [id])
  reportedById        String
  reportedBy          User             @relation("IncidentReporter", fields: [reportedById], references: [id])
  type                IncidentType
  severity            IncidentSeverity @default(MEDIUM)
  description         String
  evidenceDocumentIds String[]
  relatedType         String?
  relatedId           String?
  status              IncidentStatus   @default(OPEN)
  resolution          String?
  resolvedById        String?
  resolvedBy          User?            @relation("IncidentResolver", fields: [resolvedById], references: [id])
  resolvedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([subjectUserId, status])
  @@index([status, createdAt])
}

/// Client portal: a named marketplace filter set (Phase 5). Filters use the search schema shape.
model SavedSearch {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById String
  name        String
  filters     Json
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([clientId, name])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Agency marketplace (Agency A1): application-only agencies, owners, memberships
// ---------------------------------------------------------------------------

enum AgencyApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_MORE_INFO
  APPROVED
  REJECTED
  WITHDRAWN
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum AgencyUserRole {
  OWNER
  MANAGER
}

enum AgencyMembershipStatus {
  INVITED
  PENDING_VERIFICATION
  ACTIVE
  EXIT_REQUESTED
  REMOVAL_REQUESTED
  ENDING
  ENDED
}

enum AcceptanceContext {
  SIGNUP
  INDEPENDENT_REAPPLICATION
  REACCEPTANCE
  GENERAL
  PLACEMENT
  AGENCY_APPLICATION
  AGENT_REGISTRATION
  SUBMISSION
}

/// One active application per user. Approval is the only path (besides Super Admin) that creates an Agency.
model AgencyApplication {
  /// v2 phase 2: the plan the applicant would like; Hirewise confirms it at approval.
  preferredPlanKey        String?
  id                      String                     @id @default(cuid())
  applicantUserId         String
  applicant               User                       @relation("Applicant", fields: [applicantUserId], references: [id])
  applicantFullName       String
  applicantEmail          String
  applicantPhone          String?
  proposedAgencyName      String
  proposedLogoKey         String?
  businessRegistration    String?
  country                 String
  city                    String?
  website                 String?
  socialLinks             String[]                   @default([])
  teamSize                Int
  yearsExperience         Int
  services                String[]                   @default([])
  description             String
  /// The AgreementAcceptance (AGENCY_NON_CIRCUMVENTION) recorded when applying.
  agreementAcceptanceId   String?
  status                  AgencyApplicationStatus    @default(SUBMITTED)
  reviewerId              String?
  reviewer                User?                      @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  /// Internal only. Never in the applicant projection.
  reviewNotes             String?
  applicantVisibleMessage String?
  rejectionReason         String?
  /// Set on rejection from the configured cooldown (admin may override).
  reapplyAfter            DateTime?
  submittedAt             DateTime                   @default(now())
  resubmittedAt           DateTime?
  reviewedAt              DateTime?
  createdAgencyId         String?                    @unique
  createdAgency           Agency?                    @relation(fields: [createdAgencyId], references: [id])
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  history                 AgencyApplicationHistory[]

  @@index([applicantUserId, status])
  @@index([status, submittedAt])
  @@index([country])
}

model AgencyApplicationHistory {
  id             String                   @id @default(cuid())
  applicationId  String
  application    AgencyApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousStatus AgencyApplicationStatus?
  newStatus      AgencyApplicationStatus
  changedById    String?
  changedBy      User?                    @relation("ApplicationHistoryActor", fields: [changedById], references: [id])
  notes          String?
  changedAt      DateTime                 @default(now())

  @@index([applicationId, changedAt])
}

/// A partner agency. Created only from an approved AgencyApplication or by a Super Admin (agency.create_direct).
model Agency {
  id                          String                 @id @default(cuid())
  name                        String
  logoKey                     String?
  ownerUserId                 String
  owner                       User                   @relation("AgencyOwner", fields: [ownerUserId], references: [id])
  description                 String?
  contactEmail                String
  contactPhone                String?
  country                     String
  city                        String?
  website                     String?
  status                      AgencyStatus           @default(ACTIVE)
  statusReason                String?
  /// Membership plan (v2 phase 2). Null until Hirewise assigns one; invites open only then.
  planId                      String?
  plan                        Plan?                  @relation(fields: [planId], references: [id])
  planStartedAt               DateTime?
  trainingAccess              Boolean                @default(true)
  opportunityAccess           Boolean                @default(true)
  joinedAt                    DateTime               @default(now())
  suspendedAt                 DateTime?
  deactivatedAt               DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  application                 AgencyApplication?
  users                       AgencyUser[]
  memberships                 AgencyMembership[]
  primaryAgents               AgentProfile[]         @relation("PrimaryAgencyAgents")
  seatLedger                  AgencySeatLedger[]
  seatPurchases               SeatPurchase[]
  seatRequests                SeatRequest[]
  inviteLinks                 AgencyInviteLink[]
  emailInvites                AgencyEmailInvite[]
  coursePurchases             CoursePurchase[]
  courseSeatAssignments       CourseSeatAssignment[]
  /// v2 phase 5: client-facing Partner Team identity. Assigned by the system at approval; the name is edited only by Hirewise.
  clientFacingCode            String?                @unique
  clientFacingName            String?
  clientFacingSpecializations String[]               @default([])
  /// v2 phase 5: private identity, Hirewise Admin only.
  legalName                   String?
  addressLine                 String?
  registrationDetails         String?
  billingEmail                String?
  disclosureGrants            DisclosureGrant[]
  threads                     MessageThread[]
  bypassReports               BypassReport[]
  opportunityShares           OpportunityAgency[]
  submissions                 Submission[]

  @@index([status])
  @@index([ownerUserId])
}

/// Owner and Manager seats. Portal permissions are resolved from here onto the Actor; managers hold a configurable subset.
model AgencyUser {
  id          String         @id @default(cuid())
  agencyId    String
  agency      Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        AgencyUserRole
  permissions String[]       @default([])
  addedById   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([agencyId, userId])
  @@index([userId])
}

/// Membership history (v2 phase 2): one open membership per platform identity (partial unique index in the migration).
/// Hirewise Direct is the absence of an open membership; agencyId stays nullable only for historical rows.
model AgencyMembership {
  id                 String                 @id @default(cuid())
  agentProfileId     String
  agentProfile       AgentProfile           @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  agencyId           String?
  agency             Agency?                @relation(fields: [agencyId], references: [id])
  isPrimary          Boolean                @default(true)
  status             AgencyMembershipStatus @default(ACTIVE)
  joinedAt           DateTime               @default(now())
  leftAt             DateTime?
  approvedById       String?
  approvedBy         User?                  @relation("MembershipApprover", fields: [approvedById], references: [id])
  endReason          String?
  platformIdentityId String?
  invitationSource   InvitationSource       @default(ADMIN)
  seatLedgerEntryId  String?
  endedById          String?
  invitedEmail       String?
  /// v2 phase 3: the exit that ended (or is ending) this membership, when it ends, how and when the seat is released.
  exitRequestId      String?
  effectiveEndAt     DateTime?
  seatReleaseRule    SeatReleaseRule?
  seatReleasedAt     DateTime?
  exitRequests       ExitRequest[]
  createdAt          DateTime               @default(now())

  @@index([agentProfileId, status])
  @@index([agencyId, status])
  @@index([platformIdentityId, status])
}

// ---------------------------------------------------------------------------
// Identity phase 1: Platform Identity, duplicate detection, unified terms support
// ---------------------------------------------------------------------------

enum TalentType {
  HIREWISE_DIRECT
  AGENCY_AGENT
  INDEPENDENT_FREELANCER
}

enum IdentityStatus {
  ACTIVE
  MERGED
  BLOCKED
}

enum IdentityContactKind {
  EMAIL
  PHONE
}

enum IdentityContactSource {
  SIGNUP
  PRIVATE_CONTACT
  ADMIN
  BACKFILL
}

enum DuplicateFlagKind {
  SIGNUP
  AGENCY_APPLICATION
  INVITE_JOIN
  INDEPENDENT_REAPPLY
}

enum DuplicateFlagStatus {
  OPEN
  APPROVED_NEW_PROFILE
  LINKED
  REJECTED
}

enum PrivacyPolicyMode {
  COMBINED
  SEPARATE
}

/// Permanent, Hirewise-only record of a person. Never serialised to clients or agencies (FORBIDDEN_FOR_CLIENT / FORBIDDEN_FOR_AGENCY).
model PlatformIdentity {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id])
  status             IdentityStatus @default(ACTIVE)
  primaryEmail       String         @db.Citext
  verifiedAt         DateTime?
  /// Encrypted-at-rest references only; never raw document numbers.
  idVerificationRefs Json?
  /// Hirewise-only notes.
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  contacts       PlatformIdentityContact[]
  profiles       AgentProfile[]
  duplicateFlags DuplicateFlag[]           @relation("DuplicateFlagMatch")

  @@index([primaryEmail])
  @@index([status])
}

/// Normalised emails and phones used for duplicate detection. Not unique: a match raises a DuplicateFlag.
model PlatformIdentityContact {
  id              String                @id @default(cuid())
  identityId      String
  identity        PlatformIdentity      @relation(fields: [identityId], references: [id], onDelete: Cascade)
  kind            IdentityContactKind
  valueNormalized String
  valueDisplay    String
  verifiedAt      DateTime?
  source          IdentityContactSource @default(SIGNUP)
  createdAt       DateTime              @default(now())

  @@unique([identityId, kind, valueNormalized])
  @@index([kind, valueNormalized])
}

/// A sign-up or application that matched an existing identity. No account is created until Admin decides.
model DuplicateFlag {
  id                  String              @id @default(cuid())
  kind                DuplicateFlagKind
  attemptedEmail      String              @db.Citext
  attemptedPhone      String?
  attemptedName       String
  /// The rest of the attempted form, never a password.
  attemptedData       Json?
  matchedIdentityId   String?
  matchedIdentity     PlatformIdentity?   @relation("DuplicateFlagMatch", fields: [matchedIdentityId], references: [id])
  matchedUserId       String?
  /// EMAIL, PHONE, IDENTITY, ACTIVE_MEMBERSHIP, INDEPENDENT_PROFILE
  matchReasons        String[]
  status              DuplicateFlagStatus @default(OPEN)
  reviewedById        String?
  reviewedBy          User?               @relation("DuplicateFlagReviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  decisionNote        String?
  continuationTokenId String?
  ipAddress           String?
  createdAt           DateTime            @default(now())

  @@index([status, createdAt])
  @@index([attemptedEmail])
  @@index([matchedIdentityId])
}

// ---------------------------------------------------------------------------
// v2 phase 2: plans, Agent Seats, invitations
// ---------------------------------------------------------------------------

enum InvitationSource {
  UNIQUE_LINK
  EMAIL_INVITE
  ADMIN
  OWNER
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

/// Capacity types add or remove seats; usage types record a seat taken or given back by a membership.
enum SeatLedgerType {
  PLAN_BASE
  PURCHASE
  PROMO_GRANT
  ADMIN_ADD
  ADMIN_REMOVE
  OVERRIDE
  CONSUMED
  RELEASED
  PENDING_RELEASE
}

enum SeatPurchaseStatus {
  PENDING
  PAID
  WAIVED
  CANCELLED
}

enum SeatRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmailInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Membership plans. Prices are data (minor units), never code; Enterprise has no base seats (Admin adds them).
model Plan {
  id                String        @id @default(cuid())
  key               String        @unique
  name              String
  baseAgentSeats    Int?
  priceMinor        Int           @default(0)
  currency          String        @default("USD") @db.Char(3)
  billingPeriod     BillingPeriod @default(MONTHLY)
  trainingAccess    Boolean       @default(true)
  opportunityAccess Boolean       @default(true)
  features          String[]      @default([])
  isActive          Boolean       @default(true)
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  agencies      Agency[]
  ledgerEntries AgencySeatLedger[]
}

model SeatPackage {
  id         String   @id @default(cuid())
  name       String
  seatCount  Int
  priceMinor Int      @default(0)
  currency   String   @default("USD") @db.Char(3)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchases SeatPurchase[]
}

/// Append-only (a trigger rejects UPDATE and DELETE). Totals are always computed from these rows.
model AgencySeatLedger {
  id                    String         @id @default(cuid())
  agencyId              String
  agency                Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  changeType            SeatLedgerType
  /// Always positive; changeType carries the direction.
  quantity              Int
  reason                String?
  relatedAgentProfileId String?
  relatedMembershipId   String?
  seatPurchaseId        String?
  planId                String?
  plan                  Plan?          @relation(fields: [planId], references: [id])
  effectiveAt           DateTime       @default(now())
  createdById           String?
  createdAt             DateTime       @default(now())

  @@index([agencyId, createdAt])
  @@index([relatedMembershipId])
}

model SeatPurchase {
  id               String             @id @default(cuid())
  agencyId         String
  agency           Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  packageId        String
  package          SeatPackage        @relation(fields: [packageId], references: [id])
  seatCount        Int
  amountMinor      Int
  currency         String             @db.Char(3)
  status           SeatPurchaseStatus @default(PENDING)
  paymentReference String?
  paidAt           DateTime?
  recordedById     String?
  ledgerEntryId    String?
  note             String?
  requestedById    String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([agencyId, status])
  @@index([status, createdAt])
}

model SeatRequest {
  id             String            @id @default(cuid())
  agencyId       String
  agency         Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  requestedSeats Int
  note           String?
  status         SeatRequestStatus @default(PENDING)
  requestedById  String
  reviewedById   String?
  decisionNote   String?
  grantedSeats   Int?
  ledgerEntryId  String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([agencyId, status])
  @@index([status, createdAt])
}

/// The agency's own sign-up link. Agent-facing only; never shown to clients.
model AgencyInviteLink {
  id          String    @id @default(cuid())
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  token       String    @unique
  label       String
  active      Boolean   @default(true)
  createdById String
  uses        Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([agencyId, active])
}

model AgencyEmailInvite {
  id                   String            @id @default(cuid())
  agencyId             String
  agency               Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email                String            @db.Citext
  token                String            @unique
  status               EmailInviteStatus @default(PENDING)
  invitedById          String
  expiresAt            DateTime
  acceptedMembershipId String?
  acceptedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([agencyId, status])
  @@index([email, status])
}

// ---------------------------------------------------------------------------
// v2 phase 3: exit requests
// ---------------------------------------------------------------------------

enum ExitRequestType {
  AGENT_REQUESTED_LEAVE
  AGENCY_REQUESTED_REMOVAL
}

enum ExitEffectiveOption {
  IMMEDIATE
  END_OF_ASSIGNMENT
  END_OF_BILLING_PERIOD
}

enum ExitRequestStatus {
  PENDING_AGENCY
  PENDING_ADMIN
  APPROVED
  DECLINED
  CANCELLED
  COMPLETED
}

enum ExitDecision {
  APPROVED
  DECLINED
}

enum SeatReleaseRule {
  IMMEDIATE
  AFTER_BILLING_PERIOD
  AFTER_ASSIGNMENT_ENDS
}

/// Request to Leave (agent) or Remove Agent (agency). One open request per membership (partial unique index in the migration).
model ExitRequest {
  id                     String              @id @default(cuid())
  membershipId           String
  membership             AgencyMembership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  agencyId               String
  agentProfileId         String
  platformIdentityId     String?
  type                   ExitRequestType
  reason                 String
  effectiveOption        ExitEffectiveOption @default(IMMEDIATE)
  requestedEffectiveDate DateTime?
  status                 ExitRequestStatus   @default(PENDING_AGENCY)
  requestedById          String
  agencyDecision         ExitDecision?
  agencyDecidedById      String?
  agencyDecisionNote     String?
  agencyDecidedAt        DateTime?
  adminRequired          Boolean             @default(false)
  adminRequiredReason    String?
  adminDecision          ExitDecision?
  adminDecidedById       String?
  adminDecisionNote      String?
  adminDecidedAt         DateTime?
  escalatedAt            DateTime?
  effectiveAt            DateTime?
  completedAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([agencyId, status])
  @@index([agentProfileId, status])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// v2 phase 4: credential sources, Course Seats, independent access
// ---------------------------------------------------------------------------

enum CredentialSource {
  AGENCY_SPONSORED
  INDEPENDENT_PURCHASE
  HIREWISE_DIRECT
  ADMIN_ASSIGNMENT
}

enum CoursePurchaseStatus {
  PENDING
  PAID
  WAIVED
  CANCELLED
  REFUNDED
}

enum IndependentAccessStatus {
  PENDING_PAYMENT
  ACTIVE
  CANCELLED
}

/// Course Seats bought by an agency for one course (distinct from Agent Seats). Recorded by Hirewise.
model CoursePurchase {
  id               String               @id @default(cuid())
  agencyId         String
  agency           Agency               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  courseId         String
  course           AcademyCourse        @relation(fields: [courseId], references: [id])
  seatCount        Int
  amountMinor      Int
  currency         String               @db.Char(3)
  status           CoursePurchaseStatus @default(PENDING)
  paymentReference String?
  paidAt           DateTime?
  recordedById     String?
  requestedById    String
  note             String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  assignments CourseSeatAssignment[]

  refundedAt   DateTime?
  refundKind   RefundKind?
  refundReason String?

  @@index([agencyId, status])
  @@index([status, createdAt])
}

/// One Course Seat given to one member; the enrollment it created is agency-sponsored.
model CourseSeatAssignment {
  id               String          @id @default(cuid())
  coursePurchaseId String?
  coursePurchase   CoursePurchase? @relation(fields: [coursePurchaseId], references: [id])
  agencyId         String
  agency           Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  courseId         String
  agentProfileId   String
  enrollmentId     String?
  assignedById     String
  assignedAt       DateTime        @default(now())
  revokedAt        DateTime?
  revokeReason     String?

  @@index([agencyId, courseId])
  @@index([agentProfileId])
  @@index([coursePurchaseId])
}

/// Independent reapplication (former agency agents). The fresh independent profile is created when access is active.
model IndependentAccess {
  id                 String                  @id @default(cuid())
  userId             String
  platformIdentityId String?
  status             IndependentAccessStatus @default(PENDING_PAYMENT)
  amountMinor        Int                     @default(0)
  currency           String                  @default("USD") @db.Char(3)
  paymentReference   String?
  paidAt             DateTime?
  recordedById       String?
  profileId          String?
  fromProfileId      String?
  note               String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// v2 phase 5: client protection
// ---------------------------------------------------------------------------

enum ClientSafeDocumentType {
  RESUME
  PROFILE
  CERTIFICATE
  PORTFOLIO
  VOICE_INTRO
  VIDEO_INTRO
}

enum ClientSafeSourceType {
  VIDEO
  RECORDING
  PORTFOLIO
  CERTIFICATION
  PROFILE
}

enum SanitizationStatus {
  PENDING
  AUTO_SANITIZED
  NEEDS_MANUAL_REVIEW
  APPROVED_FOR_CLIENT
  REJECTED
}

enum DisclosureScope {
  AGENT_IDENTITY
  AGENCY_IDENTITY
  CLIENT_IDENTITY
}

enum DisclosureGrantor {
  STAFF
  SYSTEM
}

/// A client-safe version of one source item. The original is never altered; only APPROVED_FOR_CLIENT rows are served to clients.
model ClientSafeDocument {
  id                  String                 @id @default(cuid())
  agentProfileId      String
  agentProfile        AgentProfile           @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  type                ClientSafeDocumentType
  sourceType          ClientSafeSourceType
  sourceId            String
  originalStorageKey  String
  sanitizedStorageKey String?
  status              SanitizationStatus     @default(PENDING)
  /// What the scan found (kinds only, never the raw contact values).
  findings            Json?
  autoNote            String?
  reviewedById        String?
  reviewedBy          User?                  @relation("ClientSafeDocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  reviewNote          String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([sourceType, sourceId, originalStorageKey])
  @@index([agentProfileId, status])
  @@index([status])
}

/// Explicit, revocable disclosure of an identity to a client (agent full name, real agency identity) or of a client's identity to talent.
model DisclosureGrant {
  id             String            @id @default(cuid())
  scope          DisclosureScope
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentProfileId String?
  agentProfile   AgentProfile?     @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  agencyId       String?
  agency         Agency?           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  grantedBy      DisclosureGrantor
  grantedById    String?
  grantedByUser  User?             @relation("DisclosureGrantedBy", fields: [grantedById], references: [id])
  reason         String
  interviewId    String?
  grantedAt      DateTime          @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedById    String?
  revokeReason   String?

  @@index([clientId, scope])
  @@index([agentProfileId])
  @@index([agencyId])
}

// ---------------------------------------------------------------------------
// v2 phase 6a: communication and enforcement
// ---------------------------------------------------------------------------

enum ThreadKind {
  INTERVIEW_REQUEST
  PARTNER_ENQUIRY
  SUPPORT
  /// Reserved for phase 6b.
  OPPORTUNITY
  SUBMISSION
}

enum ThreadStatus {
  OPEN
  CLOSED
}

enum MeetingLinkSource {
  PROVIDER
  STAFF_PASTED
}

enum AliasOwnerType {
  AGENT_PROFILE
  AGENCY
  CLIENT
}

enum BypassReportStatus {
  REPORTED
  UNDER_REVIEW
  WARNING_ISSUED
  RESTRICTED
  SUSPENDED
  CLOSED
}

/// One mediated conversation. Clients, agents, and Partner Teams never address each other directly: Hirewise is always in the thread.
model MessageThread {
  id                  String            @id @default(cuid())
  kind                ThreadKind
  subjectType         String?
  subjectId           String?
  interviewRequestId  String?           @unique
  interviewRequest    InterviewRequest? @relation(fields: [interviewRequestId], references: [id], onDelete: Cascade)
  clientId            String?
  client              Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agencyId            String?
  agency              Agency?           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agentProfileId      String?
  agentProfile        AgentProfile?     @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  title               String
  status              ThreadStatus      @default(OPEN)
  assignedStaffUserId String?
  assignedStaff       User?             @relation("ThreadStaff", fields: [assignedStaffUserId], references: [id])
  lastMessageAt       DateTime?
  createdAt           DateTime          @default(now())
  closedAt            DateTime?
  messages            Message[]

  @@index([clientId, status])
  @@index([agencyId, status])
  @@index([agentProfileId, status])
  @@index([kind, status])
}

model Message {
  id            String            @id @default(cuid())
  threadId      String
  thread        MessageThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId  String
  author        User              @relation("MessageAuthor", fields: [authorUserId], references: [id])
  authorRole    RoleKey
  /// What recipients see. When masked, the contact details are replaced by "[removed]".
  body          String
  /// The text as typed, kept only when masking changed it. Staff only.
  originalBody  String?
  findings      String[]          @default([])
  visibleTo     MessageVisibility @default(ALL)
  heldForReview Boolean           @default(false)
  maskedAt      DateTime?
  releasedById  String?
  releasedAt    DateTime?
  blockedAt     DateTime?
  createdAt     DateTime          @default(now())

  @@index([threadId, createdAt])
  @@index([heldForReview, createdAt])
}

/// Platform addresses shown in place of real ones. Routing is a design for inbound email; outbound uses them as Reply-To once enabled.
model EmailAlias {
  id            String         @id @default(cuid())
  alias         String         @unique
  ownerType     AliasOwnerType
  ownerId       String
  routingTarget String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  @@unique([ownerType, ownerId])
}

/// "Report Direct Contact / Bypass Attempt". A case, never an automatic sanction.
model BypassReport {
  id                  String              @id @default(cuid())
  reporterUserId      String
  reporter            User                @relation("BypassReporter", fields: [reporterUserId], references: [id])
  reporterRole        RoleKey
  reportedUserId      String?
  reportedUser        User?               @relation("BypassReported", fields: [reportedUserId], references: [id])
  reportedAgencyId    String?
  reportedAgency      Agency?             @relation(fields: [reportedAgencyId], references: [id])
  reportedClientId    String?
  reportedClient      Client?             @relation(fields: [reportedClientId], references: [id])
  relatedType         String?
  relatedId           String?
  description         String
  evidenceDocumentIds String[]            @default([])
  status              BypassReportStatus  @default(REPORTED)
  assignedToUserId    String?
  assignedTo          User?               @relation("BypassAssignee", fields: [assignedToUserId], references: [id])
  decisionNotes       String?
  restrictionEndsAt   DateTime?
  decidedById         String?
  decidedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  events              BypassReportEvent[]

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@index([reportedAgencyId])
  @@index([reportedClientId])
}

/// Append-only case history.
model BypassReportEvent {
  id         String              @id @default(cuid())
  reportId   String
  report     BypassReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fromStatus BypassReportStatus?
  toStatus   BypassReportStatus
  byUserId   String?
  note       String?
  createdAt  DateTime            @default(now())

  @@index([reportId, createdAt])
}

// ---------------------------------------------------------------------------
// v2 phase 6b: opportunities and submissions
// ---------------------------------------------------------------------------

enum OpportunityStatus {
  DRAFT
  OPEN
  INTERVIEWING
  FILLED
  CLOSED
}

enum OpportunityVisibility {
  /// Every active agency plus direct talent.
  ALL_AGENCIES
  /// Only the agencies listed in OpportunityAgency.
  SELECTED_AGENCIES
  /// Hirewise Direct and independent talent only.
  DIRECT_ONLY
}

enum OpportunitySubmissionStatus {
  PENDING_REVIEW
  APPROVED_FOR_CLIENT
  DECLINED
  WITHDRAWN
  INTERVIEWING
  SELECTED
  NOT_SELECTED
}

/// A client requirement published by Hirewise to agencies and direct talent, with the client masked (phase 5 labels).
model Opportunity {
  id                String                   @id @default(cuid())
  requirementId     String                   @unique
  requirement       ClientRequirement        @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title             String
  roleSummary       String
  /// "Healthcare client, United States": what agencies and talent see instead of the company.
  maskedClientLabel String
  skills            String[]                 @default([])
  software          String[]                 @default([])
  industry          String?
  experienceLevel   ExperienceLevel?
  schedule          String?
  timezone          String?
  startDate         DateTime?
  headcount         Int                      @default(1)
  visibility        OpportunityVisibility    @default(ALL_AGENCIES)
  status            OpportunityStatus        @default(OPEN)
  publishedById     String
  publishedBy       User                     @relation("OpportunityPublisher", fields: [publishedById], references: [id])
  publishedAt       DateTime                 @default(now())
  closedAt          DateTime?
  closedReason      String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  agencies          OpportunityAgency[]
  submissions       Submission[]
  requirements      OpportunityRequirement[]

  @@index([status, publishedAt])
  @@index([clientId])
}

model OpportunityAgency {
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  agencyId      String
  agency        Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([opportunityId, agencyId])
  @@index([agencyId])
}

/// An agency (or direct talent) putting an agent forward. Hirewise reviews before the client sees the candidate.
model Submission {
  id                 String                      @id @default(cuid())
  opportunityId      String
  opportunity        Opportunity                 @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  agentProfileId     String
  agentProfile       AgentProfile                @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  agencyId           String?
  agency             Agency?                     @relation(fields: [agencyId], references: [id])
  submittedById      String
  submittedBy        User                        @relation("SubmissionSubmitter", fields: [submittedById], references: [id])
  note               String?
  status             OpportunitySubmissionStatus @default(PENDING_REVIEW)
  reviewNote         String?
  reviewedById       String?
  reviewedAt         DateTime?
  withdrawnReason    String?
  interviewRequestId String?
  interviewRequest   InterviewRequest?           @relation(fields: [interviewRequestId], references: [id])
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([opportunityId, status])
  @@index([agencyId, status])
  @@index([agentProfileId])
}

