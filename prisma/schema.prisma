model PathwayCourse {
  pathwayId  String
  pathway    SkillPathway  @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  courseId   String
  course     AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sortOrder  Int           @default(0)
  isRequired Boolean       @default(true)

  @@id([pathwayId, courseId])
}

/// What an opportunity demands of a candidate: a declared tag, a verified tag, or a certification.
model OpportunityRequirement {
  id                      String                 @id @default(cuid())
  opportunityId           String
  opportunity             Opportunity            @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skillId                 String?
  skill                   Skill?                 @relation(fields: [skillId], references: [id], onDelete: Cascade)
  certificationTemplateId String?
  certificationTemplate   CertificationTemplate? @relation(fields: [certificationTemplateId], references: [id], onDelete: Cascade)
  requiredLevel           RequirementLevel       @default(DECLARED)
  createdAt               DateTime               @default(now())

  @@index([opportunityId])
}

/// "Request a tag": the curated list grows only through staff decisions.
model SkillTagRequest {
  id                String                @id @default(cuid())
  text              String
  requestedById     String
  requestedBy       User                  @relation("SkillTagRequester", fields: [requestedById], references: [id])
  status            SkillTagRequestStatus @default(OPEN)
  note              String?
  decidedById       String?
  decidedAt         DateTime?
  mergedIntoSkillId String?
  mergedInto        Skill?                @relation("SkillTagRequestMerged", fields: [mergedIntoSkillId], references: [id])
  createdSkillId    String?
  createdSkill      Skill?                @relation("SkillTagRequestCreated", fields: [createdSkillId], references: [id])
  createdAt         DateTime              @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Referral affiliate program
// ---------------------------------------------------------------------------

enum RefundKind {
  REFUND
  CHARGEBACK
}

enum CommissionSourceType {
  ENROLLMENT
  COURSE_PURCHASE
}

enum CommissionStatus {
  ON_HOLD
  PAYABLE
  PAID
  REVERSED
}

enum AdjustmentKind {
  REFUND_AFTER_PAYOUT
  MANUAL
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

enum PayoutMethodKind {
  GCASH
  BANK_TRANSFER
}

enum ReferralFlagKind {
  EMAIL_ALIAS
  SAME_IP
  SAME_PHONE
}

/// A visit to a referral link. The IP is stored only as a keyed hash.
model ReferralClick {
  id         String   @id @default(cuid())
  referrerId String
  referrer   User     @relation(fields: [referrerId], references: [id])
  landingUrl String
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([referrerId, createdAt])
}

/// Earnings ledger. One row per confirmed payment (unique source), with the rate locked at the time of sale.
model Commission {
  id               String               @id @default(cuid())
  referrerId       String
  referrer         User                 @relation("CommissionReferrer", fields: [referrerId], references: [id])
  buyerId          String
  buyer            User                 @relation("CommissionBuyer", fields: [buyerId], references: [id])
  sourceType       CommissionSourceType
  sourceId         String
  courseId         String
  courseTitle      String
  /// Amount confirmed as paid, minus taxes and fees, in minor units.
  saleAmount       Int
  rateBps          Int
  commissionAmount Int
  currency         String               @db.Char(3)
  status           CommissionStatus     @default(ON_HOLD)
  availableAt      DateTime
  paidAt           DateTime?
  payoutId         String?
  payout           Payout?              @relation(fields: [payoutId], references: [id])
  reversedAt       DateTime?
  reversedReason   String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  adjustments CommissionAdjustment[]

  @@unique([sourceType, sourceId])
  @@index([referrerId, status])
  @@index([status, availableAt])
}

/// Signed balance changes: a negative row when a paid commission is refunded, or a manual change with a note.
model CommissionAdjustment {
  id              String         @id @default(cuid())
  referrerId      String
  referrer        User           @relation(fields: [referrerId], references: [id])
  commissionId    String?
  commission      Commission?    @relation(fields: [commissionId], references: [id])
  kind            AdjustmentKind
  amount          Int
  currency        String         @db.Char(3)
  note            String
  createdById     String
  /// Set when a payout absorbed this adjustment.
  settledPayoutId String?
  createdAt       DateTime       @default(now())

  @@index([referrerId, settledPayoutId])
}

model Payout {
  id           String           @id @default(cuid())
  referrerId   String
  referrer     User             @relation(fields: [referrerId], references: [id])
  amount       Int
  currency     String           @db.Char(3)
  method       PayoutMethodKind
  /// Masked account for the staff queue; the full details stay in PayoutDetails.
  accountLabel String
  reference    String?
  status       PayoutStatus     @default(REQUESTED)
  rejectReason String?
  requestedAt  DateTime         @default(now())
  decidedById  String?
  decidedAt    DateTime?
  paidAt       DateTime?
  createdAt    DateTime         @default(now())

  commissions Commission[]

  @@index([referrerId, status])
  @@index([status, requestedAt])
}

model PayoutDetails {
  userId           String           @id
  user             User             @relation(fields: [userId], references: [id])
  method           PayoutMethodKind
  accountName      String
  /// AES-256-GCM with AUTH_SECRET, like MFA secrets. Never returned by any view in full.
  accountNumberEnc String
  bankName         String?
  updatedAt        DateTime         @updatedAt
}

/// Evidence that a referred sign-up looks related to the referrer. Flag only, never an automatic block.
model ReferralFlag {
  id             String           @id @default(cuid())
  referrerId     String
  referrer       User             @relation("FlagReferrer", fields: [referrerId], references: [id])
  referredUserId String
  referredUser   User             @relation("FlagReferred", fields: [referredUserId], references: [id])
  kind           ReferralFlagKind
  detail         String?
  createdAt      DateTime         @default(now())
  reviewedAt     DateTime?
  reviewedById   String?

  @@unique([referredUserId, kind])
  @@index([referrerId])
}
