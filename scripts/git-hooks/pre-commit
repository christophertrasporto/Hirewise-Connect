#!/bin/sh
# main is protected on GitHub; work on a feature branch and open a pull request. Installed by: npm run hooks:install
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "Refusing to commit on main. Create a branch first: git checkout -b <type>/<slug>" >&2
  exit 1
fi
