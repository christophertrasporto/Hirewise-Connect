# Copy to .env for local development.

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Local Postgres. Either `docker compose up` (port 5432) or `npm run db:local` (port 5433).
DATABASE_URL=postgresql://hirewise:hirewise@localhost:5433/hirewise_dev

# Object storage: local disk (default) or S3-compatible (Cloudflare R2 / MinIO).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_SECRET=change-me-in-production
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=auto
# S3_BUCKET=hirewise
# S3_ACCESS_KEY_ID=minio
# S3_SECRET_ACCESS_KEY=minio12345
# S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=600

# Email: console (default) or smtp (Mailpit locally: host localhost, port 1025).
EMAIL_DRIVER=console
EMAIL_FROM="Hirewise Connect <no-reply@hirewise.example>"
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false

WORKER_POLL_MS=2000

# Session cookie signing and MFA secret encryption. Generate with: openssl rand -base64 32
AUTH_SECRET=
