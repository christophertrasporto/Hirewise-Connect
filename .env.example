# Copy to .env for local development.

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Local Postgres. Either `docker compose up` (port 5432) or `npm run db:local` (port 5433).
DATABASE_URL=postgresql://hirewise:hirewise@localhost:5433/hirewise_dev

# Object storage: local disk (default) or S3-compatible (Cloudflare R2 / MinIO).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_SECRET=change-me-in-production
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=auto
# S3_BUCKET=hirewise
# S3_ACCESS_KEY_ID=minio
# S3_SECRET_ACCESS_KEY=minio12345
# S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=600

# Email: console (default) or smtp (Mailpit locally: host localhost, port 1025).
EMAIL_DRIVER=console
EMAIL_FROM="Hirewise Connect <no-reply@hirewise.example>"
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false

WORKER_POLL_MS=2000

# Phase 5 integrations. Each has a local fake so nothing external is needed for development.
# Payments: manual (staff record offline payments), fake (dev-only pay button), stripe (Checkout + webhook at /api/webhooks/stripe).
PAYMENT_PROVIDER=fake
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Interview meeting links: none (Sales pastes a link), fake (deterministic local link), zoom (Server-to-Server OAuth app).
MEETING_PROVIDER=fake
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# SMS: console (logs) or twilio.
SMS_DRIVER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550000000

# Session cookie signing and MFA secret encryption. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Development only: return emailed links to the UI so you can follow them without a mailbox. Ignored in production.
DEV_EXPOSE_LINKS=false
